APP_NAME=Glauren
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.com

APP_LOCALE=es
APP_TIMEZONE=America/Bogota

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Base de datos (los datos que crees en cPanel > MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=TU_USUARIO_glauren
DB_USERNAME=TU_USUARIO_dbuser
DB_PASSWORD=TU_PASSWORD_SEGURA

# --- Sesión / caché (archivo = no requiere config extra) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# --- Rapyd (pagos) — pega tus llaves reales ---
RAPYD_ACCESS_KEY=
RAPYD_SECRET_KEY=
RAPYD_BASE_URL=https://api.rapyd.net
RAPYD_COUNTRY=CO
RAPYD_CURRENCY=COP

# --- Correo (opcional, para notificaciones futuras) ---
MAIL_MAILER=log
